  const ipfsHash = await publishToIPFS(packageToPublish);
  const anchor = await anchorOnChain(ipfsHash);
  bundle.signatures.bookpi = signature;
  bundle.anchor = anchor;
  return { bundle, ipfsHash, anchor };
