                self.validos.add((nodos[0], nodos[1]))  # Agregar nuevos valores generados
                self.pesos.append(nodos[0])  # Agregar el peso generado a la lista
                self.sezgos.append(nodos[1])  # Agregar el sesgo generado a la lista
